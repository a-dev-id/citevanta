# =============================================================================
# CiteVanta production settings (shared cPanel hosting)
#
# Copy this file to ".env" in the app folder on the server (for example
# /home/USER/citevanta/.env) and fill in every value marked CHANGE.
# Never upload your local .env. Never commit the real .env to git.
# After changing this file: Admin > System > "Run deploy tasks"
# (or over SSH: php artisan config:cache).
# =============================================================================

# --- App ------------------------------------------------------------------------
APP_NAME=CiteVanta
APP_ENV=production
# CHANGE: generate once with "php artisan key:generate --show" (or see docs/DEPLOY.md
# for the no-SSH way) and paste the whole value, including "base64:".
APP_KEY=
# Must be false in production: error pages would otherwise show secrets.
APP_DEBUG=false
# CHANGE: the full address of the app, with https and no trailing slash.
APP_URL=https://citevanta.a-dashboard.com
# Added as ?v= to the favicon links. Raise it (2, 3, ...) when the icon changes,
# so browsers fetch the new one instead of showing a cached old icon.
APP_ASSET_VERSION=1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Logs (storage/logs/laravel-YYYY-MM-DD.log, kept 14 days) -------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# --- Database (cPanel > MySQL Databases) ----------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
# CHANGE: cPanel prefixes names with your account, e.g. USER_citevanta.
DB_DATABASE=CHANGE_citevanta
DB_USERNAME=CHANGE_citevanta
DB_PASSWORD=
# Tables are created with InnoDB (needed for foreign keys and transactions).
DB_ENGINE=InnoDB

# --- Sessions, cache, queue: all in the database (no Redis on shared hosting) --
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookies only over HTTPS.
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (cPanel > Email Accounts, then "Connect Devices" for the settings) ---
# Used for email verification and password reset.
MAIL_MAILER=smtp
# smtps = SSL on port 465 (most cPanel hosts). For STARTTLS on port 587 use
# MAIL_SCHEME=smtp and MAIL_PORT=587.
MAIL_SCHEME=smtps
# CHANGE: usually mail.yourdomain.com (shown in cPanel "Connect Devices").
MAIL_HOST=citevanta.a-dashboard.com
MAIL_PORT=465
# CHANGE: the full email address and its password.
MAIL_USERNAME=noreply@citevanta.a-dashboard.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@citevanta.a-dashboard.com
MAIL_FROM_NAME="${APP_NAME}"

# --- CiteVanta: AI engine -------------------------------------------------------
# openai = real scans (costs money). fake = offline test answers.
CITEVANTA_ENGINE=openai
# CHANGE: from https://platform.openai.com/api-keys (starts with sk-).
OPENAI_API_KEY=
# The model that answers like ChatGPT (with web search), and the cheaper model
# that reads the answers. Each needs a price in config/citevanta.php.
CITEVANTA_SCAN_MODEL=gpt-6.1-terra
CITEVANTA_ANALYSIS_MODEL=gpt-6-luna
# Used by scan:test when --runs is not given.
CITEVANTA_RUNS_PER_PROMPT=3

# --- CiteVanta: timeouts (each must be bigger than the one before) --------------
#   OPENAI_REQUEST_TIMEOUT < CITEVANTA_JOB_TIMEOUT < DB_QUEUE_RETRY_AFTER
# One HTTP call to OpenAI, in seconds:
OPENAI_REQUEST_TIMEOUT=60
# One scan job (exactly one API call) must finish within this:
CITEVANTA_JOB_TIMEOUT=70
# A job held by a cron run that died is retried after this many seconds:
DB_QUEUE_RETRY_AFTER=180
# Seconds one command-cron run (every minute) spends processing jobs:
CRON_WORK_SECONDS=50
# What a URL-cron web request asks set_time_limit() for (the host default is 30):
CRON_TIME_LIMIT=120

# --- CiteVanta: cron URL secret -------------------------------------------------
# Protects the fallback URL cron /cron/{token}. At least 40 random characters.
# Generate one on your computer (or any PHP): php -r "echo bin2hex(random_bytes(24));"
# Empty disables the URL cron (the command cron still works).
CRON_TOKEN=

# --- CiteVanta: scan cost limits per answer ----------------------------------
# FREE = free audits and trials (cheapest). PAID = paying and Private plan scans.
# Measured 20 Nov 2026 (gpt-5-mini): FREE about $0.016 per answer,
# PAID about $0.017 per answer with 10 of 10 answers naming hotels.
CITEVANTA_SCAN_MAX_TOOL_CALLS_FREE=2
CITEVANTA_SCAN_MAX_OUTPUT_TOKENS_FREE=1200
CITEVANTA_SCAN_MAX_TOOL_CALLS_PAID=3
CITEVANTA_SCAN_MAX_OUTPUT_TOKENS_PAID=1600
CITEVANTA_SCAN_REASONING_EFFORT=low
CITEVANTA_SEARCH_CONTEXT_SIZE=low
# Reasoning effort when gpt-6-luna reads each answer. It does not accept "minimal":
# supported are none, low, medium, high, xhigh, max. "none" = no reasoning (cheapest).
# Empty = the setting is not sent. (CITEVANTA_ANALYSIS_MODEL=gpt-6-luna above.)
CITEVANTA_ANALYSIS_REASONING_EFFORT=none

# --- CiteVanta: AI budget (USD per month, resets on the 1st, Asia/Makassar) ----
# Checked before every AI call. Paying customers use what the total leaves
# after audits, trials and admin. Keep the total below your OpenAI credit.
AI_BUDGET_TOTAL=70
AI_BUDGET_AUDITS=10
AI_BUDGET_TRIALS=10
AI_BUDGET_ADMIN=10
# A paid team's AI cost per month may not exceed this % of its plan price
# (manual scans and content; scheduled scans still run).
TEAM_COST_CAP_PERCENT=30

# --- CiteVanta: free audit and trials -----------------------------------------
# New free audits per day (the AI_BUDGET_AUDITS money cap also applies).
AUDIT_DAILY_BUDGET=5
# true: every new trial waits for an admin to approve it (Admin > Teams).
TRIAL_REQUIRES_APPROVAL=true

# --- CiteVanta: public website ----------------------------------------------
# Where the contact form goes (empty = the admin users' emails).
CONTACT_EMAIL=
# 1200x630 image for link previews, e.g. /images/og.png (optional).
SITE_OG_IMAGE=
# Cloudflare Turnstile on the audit, contact and registration forms.
# CHANGE: from dash.cloudflare.com > Turnstile (empty = honeypot only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- CiteVanta: email --------------------------------------------------------
# Outgoing mail limit per hour (shared hosting limit); the rest waits in the queue.
MAIL_MAX_PER_HOUR=100

# --- CiteVanta: billing ------------------------------------------------------
# manual = bank transfer, confirmed by an admin on Admin > Billing.
# xendit = Xendit payment links and automatic renewal (needs the keys below).
BILLING_PROVIDER=manual
# Tax on invoices in percent (e.g. 11 for PPN); 0 = no tax line.
BILLING_TAX_RATE=0
# true: plan prices already include the tax.
BILLING_PRICES_INCLUDE_TAX=true
# Shown on invoices as the contact address (optional).
BILLING_EMAIL=
# Xendit: only used when BILLING_PROVIDER=xendit.
# CHANGE: Xendit dashboard > Settings > API keys / Webhooks.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# test or live (must match the secret key).
XENDIT_MODE=test

# --- CiteVanta: Google (Private plan: GA4 and Search Console) ---------------
# See docs/GOOGLE-SETUP.md. Empty GOOGLE_CLIENT_ID = fake Google data.
# CHANGE: from Google Cloud > APIs & Services > Credentials (OAuth client).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# CHANGE: the agent account hotels share GA4 and Search Console with.
GOOGLE_AGENT_EMAIL=

VITE_APP_NAME="${APP_NAME}"

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Added as ?v= to the favicon links; raise it when the icon changes
APP_ASSET_VERSION=1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=citevanta2
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- CiteVanta: reports (Private plan) -------------------------------------
# Low-click-rate opportunities in the Google Search report: a query needs at least
# this many impressions in the period.
REPORT_OPPORTUNITY_MIN_IMPRESSIONS=100

VITE_APP_NAME="${APP_NAME}"

# CiteVanta / OpenAI
OPENAI_API_KEY=
# Seconds for one HTTP call to the AI engine. Must be below CITEVANTA_JOB_TIMEOUT.
OPENAI_REQUEST_TIMEOUT=60
CITEVANTA_SCAN_MODEL=gpt-5-mini
CITEVANTA_ANALYSIS_MODEL=gpt-5-mini
CITEVANTA_RUNS_PER_PROMPT=3
# fake = offline FakeEngine (no API calls), openai = real engine
CITEVANTA_ENGINE=fake

# --- Background scans (cron + database queue) ---------------------------------
# Timeouts must grow in this order:
#   OPENAI_REQUEST_TIMEOUT (60) < CITEVANTA_JOB_TIMEOUT (70) < DB_QUEUE_RETRY_AFTER (180)
# One ScanPromptJob makes exactly one API call, so it must finish within the job
# timeout; a job reserved by a cron run that died is retried after retry_after.
CITEVANTA_JOB_TIMEOUT=70
DB_QUEUE_RETRY_AFTER=180
# Seconds one CLI cron run (every minute) spends processing jobs.
CRON_WORK_SECONDS=50
# What a web cron call asks set_time_limit() for (shared hosts default to 30).
CRON_TIME_LIMIT=120
# Secret for the fallback URL cron /cron/{token}. At least 40 random characters.
# Empty disables the URL. Generate one with: php -r "echo bin2hex(random_bytes(24));"
CRON_TOKEN=

# Public website and free audit (optional)
# CONTACT_EMAIL: where the contact form goes (default: admin users' emails)
CONTACT_EMAIL=
# SITE_OG_IMAGE: 1200x630 image for link previews, e.g. /images/og.png
SITE_OG_IMAGE=
# AUDIT_DAILY_BUDGET: new free audits per day (each costs about one scan of 10 questions)
AUDIT_DAILY_BUDGET=5

# Billing
# BILLING_PROVIDER: manual (bank transfer, confirmed by an admin) or xendit
BILLING_PROVIDER=manual
# Tax on invoices in percent (e.g. 11 for PPN); 0 = no tax line
BILLING_TAX_RATE=0
# true: plan prices already include the tax
BILLING_PRICES_INCLUDE_TAX=true
# Shown on invoices as the contact address (optional)
BILLING_EMAIL=
# Xendit (only used when BILLING_PROVIDER=xendit). Dashboard > Settings > API keys / Webhooks.
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
# test or live (must match the secret key)
XENDIT_MODE=test

# Outgoing mail limit per hour (shared hosting); the rest waits in the queue
MAIL_MAX_PER_HOUR=100

# AI budget (USD per month, resets on the 1st, Asia/Makassar). Checked before every AI call.
# Paying customers use what the total leaves after audits, trials and admin.
AI_BUDGET_TOTAL=70
AI_BUDGET_AUDITS=10
AI_BUDGET_TRIALS=10
AI_BUDGET_ADMIN=10
# A paid team's AI cost per month may not exceed this % of its plan price (manual scans and content)
TEAM_COST_CAP_PERCENT=30
# Cost limits per scan answer (see config/citevanta.php ai_limits)
# FREE: free audits and trials (cheapest). PAID: paying and Private plan scans.
CITEVANTA_SCAN_MAX_TOOL_CALLS_FREE=2
CITEVANTA_SCAN_MAX_OUTPUT_TOKENS_FREE=1200
CITEVANTA_SCAN_MAX_TOOL_CALLS_PAID=3
CITEVANTA_SCAN_MAX_OUTPUT_TOKENS_PAID=1600
CITEVANTA_SCAN_REASONING_EFFORT=low
CITEVANTA_SEARCH_CONTEXT_SIZE=low

# Free trial: every new trial waits for an admin to approve it (Admin > Teams)
TRIAL_REQUIRES_APPROVAL=true

# Cloudflare Turnstile on the audit, contact and registration forms (empty = honeypot only)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google (Private plan: GA4 and Search Console through one agent account). See docs/GOOGLE-SETUP.md.
# Empty GOOGLE_CLIENT_ID = fake Google data (local development).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AGENT_EMAIL=
# Google API calls our jobs may make per minute (the default is well under Google's quotas).
GOOGLE_REQUESTS_PER_MINUTE=30
